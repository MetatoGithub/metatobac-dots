{
    "layer": "top",
    "position": "top",
    "height": 45,
    "spacing": 4,

    "modules-left": [
        "custom/power",
        "mango/workspaces"
    ],

    "modules-center": [
      "custom/cava_left",
      "clock",
      "custom/cava_right"
    ],

    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "tray"
    ],

    "mango/workspaces": {
        "format": "{icon}",
        "format-icons": {
          "active": " ",
          "default": " ",
          "urgent": "󰀨 "
        },
        "on-click": "activate",
        "sort-by-number": true,
        "hide-empty": false,
        "pinned": [1,2,3,4]
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d/%m/%Y %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": true
    },

    "memory": {
        "format": "  {}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },

    "tray": {
        "spacing": 8
    },
    "custom/power": {
      "format": "󰣇 ",
      "on-click": "wlogout -p layer-shell -b 4 -c 0 -r 5 -m 500"
    },
    "custom/cava_left": {
      "format": "{}",
      "exec": "~/.config/waybar/cava_left.sh",
      "on-click-left": "playerctl play-pause"
    },
      "custom/cava_right": {
      "format": "{}",
      "exec": "~/.config/waybar/cava_right.sh",
      "on-click-left": "playerctl play-pause"
    }

}
