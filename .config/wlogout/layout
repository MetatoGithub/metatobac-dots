    {
        "label": "lock",
        "action": "sleep 1 && swaylock --screenshots --clock --indicator --indicator-radius 100 --indicator-thickness 7 --effect-blur 7x5 --effect-vignette 0.5:0.5 --ring-color ff0045 --key-hl-color 00ff00 --line-color 00000000 --inside-color 00000088 --separator-color 00000000 --grace 2 --fade-in 0.2",
        "text": "Lock",
        "keybind": "l"
    },
    {
        "label": "logout",
        "action": "mmsg dispatch quit",
        "text": "Logout",
        "keybind": "e"
    },
    {
        "label": "reboot",
        "action": "systemctl reboot",
        "text": "Reboot",
        "keybind": "r"
    },
    {
        "label": "shutdown",
        "action": "systemctl poweroff",
        "text": "Poweroff",
        "keybind": "p"
    }

